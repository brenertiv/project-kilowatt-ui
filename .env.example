# Copy to .env.local and fill in. Never commit real values.
# The amCharts 5 license key, which removes the amCharts logo from charts (src/charts/useChart.ts).
VITE_AMCHARTS_LICENSE=
# A CARTO API access token, for CARTO's platform APIs: deck.gl's CARTO data sources and fetchMap (src/maps/carto.ts).
# The basemaps don't need it. It ships in the public Storybook bundle, so use a token scoped to read only what maps show.
VITE_CARTO_API_KEY=

{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "kilowatt-ui",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "exec npx vite --port \"${PORT:-5173}\" --strictPort"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "cosmos",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "COSMOS=1 exec npx cosmos"
      ],
      "port": 5100
    },
    {
      "name": "storybook",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "exec npx storybook dev --port \"${PORT:-6006}\" --no-open --ci"
      ],
      "port": 6006,
      "autoPort": true
    }
  ]
}

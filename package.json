{
  "name": "project-kilowatt-ui",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "figma:snapshot": "node scripts/figma-snapshot.mjs",
    "storybook": "npm run docs:build && storybook dev -p 6006",
    "build-storybook": "npm run docs:build && storybook build && tsx scripts/build-llms.ts && tsx scripts/check-docs.ts",
    "test:unit": "vitest run --project unit",
    "test:stories": "vitest run --project storybook",
    "docs:build": "tsx scripts/build-docs.ts",
    "docs:check": "tsx scripts/check-docs.ts"
  },
  "dependencies": {
    "@amcharts/amcharts5": "^5.20.5",
    "@base-ui/react": "^1.8.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hello-pangea/dnd": "^18.0.1",
    "@mui/material": "^9.5.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.13",
    "axios": "^1.20.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "i18next": "^26.4.2",
    "leaflet": "^1.9.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-grid-layout": "^2.2.4",
    "react-i18next": "^17.0.14",
    "react-leaflet": "^5.0.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-designs": "^11.1.4",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-mcp": "^10.6.2",
    "@storybook/addon-vitest": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/react-grid-layout": "^1.3.6",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/browser-playwright": "^5.0.4",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-storybook": "^10.6.2",
    "jsdom": "^30.0.1",
    "playwright": "^1.64.1",
    "prettier": "^3.9.6",
    "remark-gfm": "^4.0.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "storybook": "^10.6.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.1.5",
    "vite-plugin-checker": "^0.14.5",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.0.4"
  }
}

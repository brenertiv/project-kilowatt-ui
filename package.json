    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/browser-playwright": "^5.0.4",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-storybook": "^10.6.2",
    "jsdom": "^30.0.1",
    "playwright": "^1.64.1",
    "prettier": "^3.9.6",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.6.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2",

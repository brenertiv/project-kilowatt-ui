    "@tanstack/react-query": "^5.102.8",
    "axios": "^1.20.0",
    "date-fns": "^4.4.0",
    "i18next": "^26.4.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^17.0.14"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-mcp": "^10.6.2",
    "@storybook/addon-vitest": "^10.6.2",
    "@storybook/mcp": "^10.6.2",
